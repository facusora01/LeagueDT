generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Summoner {
  id            String   @id @default(uuid())
  puuid         String   @unique
  accountId     String   @unique
  summonerId    String   @unique
  name          String
  tagLine       String
  profileIconId Int
  level         Int
  region        String
  lastUpdated   DateTime
  createdAt     DateTime @default(now())

  championMasteries ChampionMastery[]
  participants      Participant[]
  liveParticipants  LiveParticipant[]
  recommendations   Recommendation[]
  statistics        UserStatistics?
  preferences       UserPreference?

  @@index([name, region])
}

model Champion {
  id      Int    @id
  key     String @unique
  name    String
  title   String
  blurb   String
  tags    String // JSON string of tags array
  info    String // JSON string of ChampionInfo
  stats   String // JSON string of ChampionStats
  version String

  masteries    ChampionMastery[]
  participants Participant[]
}

model ChampionMastery {
  id           String   @id @default(uuid())
  summonerId   String
  championId   Int
  level        Int
  points       Int
  lastPlayTime DateTime
  chestGranted Boolean
  tokensEarned Int

  summoner Summoner @relation(fields: [summonerId], references: [id])
  champion Champion @relation(fields: [championId], references: [id])

  @@unique([summonerId, championId])
  @@index([summonerId])
}

model Match {
  id           String   @id
  gameId       BigInt
  platformId   String
  queueId      Int
  mapId        Int
  seasonId     Int
  gameCreation DateTime
  gameDuration Int
  gameMode     String
  gameType     String
  gameVersion  String
  createdAt    DateTime @default(now())

  teams        Team[]
  participants Participant[]

  @@index([gameCreation, gameMode])
}

model Team {
  id              String @id @default(uuid())
  matchId         String
  teamId          Int
  win             Boolean
  firstBlood      Boolean
  firstTower      Boolean
  firstInhibitor  Boolean
  firstBaron      Boolean
  firstDragon     Boolean
  firstRiftHerald Boolean
  towerKills      Int
  inhibitorKills  Int
  baronKills      Int
  dragonKills     Int
  riftHeraldKills Int

  match Match         @relation(fields: [matchId], references: [id])
  bans  ChampionBan[]

  @@index([matchId, teamId])
}

model ChampionBan {
  id         String @id @default(uuid())
  teamId     String
  championId Int
  pickTurn   Int

  team Team @relation(fields: [teamId], references: [id])
}

model Participant {
  id                          String  @id @default(uuid())
  matchId                     String
  teamId                      Int
  championId                  Int
  summonerId                  String?
  summonerName                String
  participantId               Int
  kills                       Int
  deaths                      Int
  assists                     Int
  goldEarned                  Int
  goldSpent                   Int
  totalDamageDealt            Int
  totalDamageDealtToChampions Int
  totalDamageTaken            Int
  totalHeal                   Int
  visionScore                 Int
  wardsPlaced                 Int
  wardsKilled                 Int
  creepScore                  Int
  neutralMinionsKilled        Int
  teamObjectiveKills          Int
  win                         Boolean
  items                       String  // JSON: number[]
  perk0                       Int     @default(0)
  perk1                       Int     @default(0)
  perk2                       Int     @default(0)
  perk3                       Int     @default(0)
  perk4                       Int     @default(0)
  perk5                       Int     @default(0)
  perkPrimaryStyle            Int     @default(0)
  perkSubStyle                Int     @default(0)
  statPerks                   String  @default("{}") // JSON: StatPerks
  role                        String
  lane                        String

  match    Match     @relation(fields: [matchId], references: [id])
  summoner Summoner? @relation(fields: [summonerId], references: [id])
  champion Champion  @relation(fields: [championId], references: [id])

  @@index([summonerId, championId])
  @@index([matchId, teamId])
}

model Item {
  id          Int    @id
  name        String
  description String
  plaintext   String
  into        String // JSON: number[]
  from        String // JSON: number[]
  gold        String // JSON: ItemGold
  tags        String // JSON: string[]
  stats       String // JSON: ItemStats
  version     String
}

model Rune {
  id        Int    @id
  key       String @unique
  name      String
  icon      String
  shortDesc String
  longDesc  String
  tier      Int
  type      String
  version   String
}

model LiveMatch {
  id                 String   @id @default(uuid())
  gameId             BigInt   @unique
  mapId              Int
  gameMode           String
  gameType           String
  gameQueueConfigId  Int
  gameStartTime      DateTime
  gameLength         Int
  platformId         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  participants    LiveParticipant[]
  bannedChampions LiveChampionBan[]

  @@index([gameId])
}

model LiveChampionBan {
  id          String @id @default(uuid())
  liveMatchId String
  championId  Int
  teamId      Int
  pickTurn    Int

  liveMatch LiveMatch @relation(fields: [liveMatchId], references: [id])
}

model LiveParticipant {
  id             String  @id @default(uuid())
  liveMatchId    String
  teamId         Int
  championId     Int
  summonerId     String
  summonerName   String
  spell1Id       Int
  spell2Id       Int
  perk0          Int     @default(0)
  perk1          Int     @default(0)
  perk2          Int     @default(0)
  perk3          Int     @default(0)
  perk4          Int     @default(0)
  perk5          Int     @default(0)
  perkPrimaryStyle Int   @default(0)
  perkSubStyle   Int     @default(0)
  isBot          Boolean @default(false)
  isDead         Boolean @default(false)
  kills          Int     @default(0)
  deaths         Int     @default(0)
  assists        Int     @default(0)
  goldEarned     Int     @default(0)
  level          Int     @default(1)
  items          String  @default("[]") // JSON: number[]

  liveMatch LiveMatch @relation(fields: [liveMatchId], references: [id])
  summoner  Summoner  @relation(fields: [summonerId], references: [id])
}

model Recommendation {
  id          String   @id @default(uuid())
  summonerId  String
  type        String   // RecommendationType enum value
  context     String   // RecommendationContext enum value
  priority    Int
  title       String
  description String
  reasoning   String
  data        String   @default("{}") // JSON
  confidence  Float
  timestamp   DateTime @default(now())
  dismissed   Boolean  @default(false)
  actedUpon   Boolean  @default(false)
  matchId     String?

  summoner Summoner @relation(fields: [summonerId], references: [id])

  @@index([summonerId, timestamp])
  @@index([summonerId, type])
}

model UserStatistics {
  id                    String   @id @default(uuid())
  summonerId            String   @unique
  totalMatches          Int      @default(0)
  wins                  Int      @default(0)
  losses                Int      @default(0)
  winRate               Float    @default(0)
  averageKDA            Float    @default(0)
  averageCSPerMinute    Float    @default(0)
  averageGoldPerMinute  Float    @default(0)
  averageDamagePerMinute Float   @default(0)
  averageVisionScore    Float    @default(0)
  mostPlayedChampions   String   @default("[]")  // JSON: ChampionStats[]
  roleDistribution      String   @default("{}") // JSON: RoleDistribution
  improvementTrend      Float    @default(0)
  lastUpdated           DateTime @updatedAt

  summoner Summoner @relation(fields: [summonerId], references: [id])
}

model UserPreference {
  id                   String   @id @default(uuid())
  summonerId           String   @unique
  theme                String   @default("dark")
  language             String   @default("es_AR")
  notificationsEnabled Boolean  @default(true)
  soundEnabled         Boolean  @default(true)
  overlayEnabled       Boolean  @default(true)
  overlayPosition      String   @default("TOP_RIGHT")
  recommendationLevel  String   @default("DETAILED")
  autoImportRunes      Boolean  @default(false)
  region               String   @default("LA2")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  summoner Summoner @relation(fields: [summonerId], references: [id])
}
